-        setIsNewUser(true);
+        // Önce Sakin host köprüsünü dene — host isim+doğum yazdıysa onboarding'i atla
+        const bridged = tryLoadSakinBridge();
+        if (bridged) {
+          setProfile(bridged);
+          await AsyncStorage.setItem(STORAGE_KEYS.PROFILE, JSON.stringify(bridged));
+        } else {
