@@ -51,6 +51,62 @@ const STORAGE_KEYS = {
 
 const todayStr = () => new Date().toISOString().split('T')[0];
 
+// SAKİN HOST KÖPRÜSÜ — Sakin ana uygulaması (host), bu embed'i bir iframe içinde
+// açtığında isim + doğum bilgisini embed'in localStorage'ına yazar (aynı origin).
+//
+// ÖNEMLİ: `element` bir KİŞİLİK SORUSUDUR (onboarding adım 2 — "Hangi unsura yakın
+// hissediyorsun?"), doğum tarihinden TÜRETİLEMEZ. Zodyaktan element üretmek kardeş
+// uygulamada (sakinhayvan) hataya yol açtı. Bu yüzden host köprüsü SADECE isim + doğum
+// bilgisini ÖN-DOLDURUR; profili kendisi YARATMAZ. Onboarding gösterilmeye devam eder
+// ama isim adımı atlanıp doğrudan element seçim adımına atlanır (KISMİ atlama). Profil
+// yalnızca kullanıcı bir element seçtikten sonra yazılır — elementsiz/geçersiz profil ASLA.
+export interface SakinPrefill {
+  name: string;
+  fullName?: string;
+  birthDate?: string;   // YYYY-MM-DD
+  birthHour?: number;
+  birthMinute?: number;
+  birthCity?: string;
+}
+
+function loadSakinPrefill(): SakinPrefill | null {
+  try {
+    if (typeof window === 'undefined' || !window.localStorage) return null;
+    const ls = window.localStorage;
+    const get = (...keys: string[]) => {
+      for (const k of keys) {
+        const v = ls.getItem(k);
+        if (v) return v;
+      }
+      return '';
+    };
+    const name = get('sakin_name', 'user_name', 'userName');
+    const birthDate = get('sakin_birth_date', 'birth_date', 'birthDate');
+    // Host verisi yoksa köprü yok — normal onboarding'e düş
+    if (!name && !birthDate) return null;
+    // Doğum saati (HH:MM) — opsiyonel; saat/dakikaya ayır
+    const birthTime = get('sakin_birth_time', 'birth_time', 'birthTime');
+    let birthHour: number | undefined;
+    let birthMinute: number | undefined;
+    if (birthTime) {
+      const tp = birthTime.split(':').map((s) => parseInt(s, 10));
+      if (Number.isFinite(tp[0])) birthHour = tp[0];
+      if (Number.isFinite(tp[1])) birthMinute = tp[1];
+    }
+    const birthCity = get('sakin_birth_city', 'birth_city', 'birthCity') || undefined;
+    return {
+      name: name || '',
+      fullName: name || undefined,
+      birthDate: birthDate || undefined,
+      birthHour,
+      birthMinute,
+      birthCity,
+    };
+  } catch {
+    return null;
+  }
+}
