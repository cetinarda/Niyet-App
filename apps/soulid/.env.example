# ─── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=<your-supabase-project-url>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>
# Service role — SADECE server-side (Edge route). NEXT_PUBLIC_ ön eki YOK.
# Webhook'lar entitlements tablosuna service_role ile yazar.
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role>

# ─── Groq (ÜCRETSİZ — metin anlatımı için birincil sağlayıcı) ─
# Server-only. console.groq.com/keys → ücretsiz katman, kredi kartı istemez.
# Anlatım metinleri (karne + uyum) önce Groq'tan üretilir → maliyet sıfır.
# Çıktı bölüm formatına uymazsa otomatik Anthropic'e düşer.
# Model değiştirmek istersen GROQ_MODEL ile ez (varsayılan llama-3.3-70b-versatile).
GROQ_API_KEY=<your-groq-key>
# GROQ_MODEL=llama-3.3-70b-versatile

# ─── Anthropic Claude API (yedek + premium) ────────────────
# Server-only — Edge route /api/ai/* arkasında. NEXT_PUBLIC_ ön eki YOK.
# Tarayıcıya inlinelanmaz. Anthropic dashboard'da daily spending limit önerilir.
# Groq varsa ücretsiz akışta ÇAĞRILMAZ; sadece Groq düşerse ve premium derin
# analizde (kalite önceliği) kullanılır. İkisi de yoksa statik fallback devreye girer.
ANTHROPIC_API_KEY=<your-anthropic-key>

# ─── AI Kahraman Portresi (opsiyonel) ──────────────────────
# Server-only — /api/ai/portrait Edge route arkasında. Claude görsel ÜRETMEZ;
# fotoğraf→RPG karakter dönüşümü için ayrı görsel modeli (gpt-image-1) gerekir.
# Anahtar YOKSA route 503 döner ve uygulama cihaz-üstü boyama efektine düşer.
# gpt-image-1 OpenAI'de organizasyon doğrulaması ister. Spending limit koy.
OPENAI_API_KEY=<your-openai-key>

# ─── App URL (origin whitelist için) ───────────────────────
NEXT_PUBLIC_APP_URL=https://soulprofile.life

# ─── Stripe (web ödeme) ────────────────────────────────────
# secret server-only — NEXT_PUBLIC_ ön eki YOK
STRIPE_SECRET_KEY=<your-stripe-secret>
NEXT_PUBLIC_STRIPE_PRICE_UNLOCK=<your-stripe-price-id>
# Webhook signature secret (sonraki sprintte stripe-webhook route için)
STRIPE_WEBHOOK_SECRET=<your-stripe-webhook-secret>

# ─── RevenueCat (iOS + Android IAP) ────────────────────────
# Dashboard → Project → Apps → bundle ID → "public" key
NEXT_PUBLIC_REVENUECAT_IOS_KEY=<your-revenuecat-ios-key>
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=<your-revenuecat-android-key>
# RC Dashboard → Integrations → Webhooks → URL: /api/revenuecat-webhook
# Authorization Header'a yazdığın string'i buraya koy.
REVENUECAT_WEBHOOK_SECRET=<your-rc-webhook-secret>

# ─── DEVELOPMENT TOGGLE ────────────────────────────────────
# Footer'daki "Premium AÇ/KAPAT" butonunu açar.
# ⚠ PRODUCTION'DA ASLA TANIMLAMA — varsayılan tanımsız = otomatik gizli.
# Netlify production env panelinde bu key'i ÇIKAR.
# NEXT_PUBLIC_SHOW_DEV_TOGGLE=1
